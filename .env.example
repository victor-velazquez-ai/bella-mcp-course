# Copy to .env (never commit .env). Everything is optional: with nothing set,
# Bella runs locally over stdio, no auth, and her brain runs in free demo mode.

# ---------------------------------------------------------------- Bella's brain
# Set ONE (or none = demo mode). Used only by ask_bella to turn English into SQL.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# BELLA_MODEL=claude-opus-5-5
# MOCK=1                      # force demo mode even if you have a key

# ---------------------------------------------------------------- Server
# BELLA_HOST=127.0.0.1        # use 0.0.0.0 inside Docker / on a server
# BELLA_PORT=8000             # (PORT is also honoured, for Render/Railway)
# BELLA_PUBLIC_URL=http://localhost:8000   # public base URL (needed for OAuth)
# BELLA_DB_PATH=data/bella.db
# BELLA_MAX_ROWS=200
# BELLA_QUERY_TIMEOUT_MS=2000

# ---------------------------------------------------------------- Auth
# none (default) | jwt | github
# BELLA_AUTH_MODE=none

# none mode: which role the local user gets (viewer | analyst | admin)
# BELLA_LOCAL_ROLE=analyst

# jwt mode — course default: the local key pair created by scripts/mint_token.py
# For a real IdP (Entra ID, Okta, Auth0, Keycloak) set BELLA_JWKS_URI instead.
# BELLA_JWT_ISSUER=https://auth.brightline.local
# BELLA_JWT_AUDIENCE=bella-mcp
# BELLA_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys

# github mode — create a GitHub OAuth App, callback URL = <BELLA_PUBLIC_URL>/auth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# BELLA_GITHUB_ROLES=your-github-login:admin,teammate:analyst
# BELLA_GITHUB_DEFAULT_ROLE=viewer          # or "none" to block everyone else
# BELLA_JWT_SIGNING_KEY=                     # stable key so restarts don't log everyone out
